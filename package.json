{
  "name": "dehqon-market-workspace",
  "version": "1.0.0",
  "description": "Dehqon Market Full-Stack Web Platform Workspace",
  "scripts": {
    "install:all": "npm install --prefix server && npm install --prefix client --legacy-peer-deps",
    "start:server": "npm start --prefix server",
    "start:client": "npm run dev --prefix client",
    "build:client": "npm run build --prefix client",
    "build": "node build-all.js",
    "start": "npm run start:server",
    "dev": "node start-dev.js"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "framer-motion": "^12.42.2",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^1.26.0",
    "multer": "^1.4.5-lts.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "typescript": "^5.2.2",
    "vite": "^8.1.1"
  }
}
