{
  "name": "dehqon-market-workspace",
  "version": "1.0.0",
  "description": "Dehqon Market Full-Stack Web Platform Workspace",
  "scripts": {
    "install:all": "npm install --prefix server && npm install --prefix client --legacy-peer-deps",
    "start:server": "npm start --prefix server",
    "start:client": "npm run dev --prefix client",
    "build:client": "npm run build --prefix client",
    "build": "node build-all.js",
    "start": "npm run start:server",
    "dev": "node start-dev.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1"
  },
  "devDependencies": {
    "typescript": "^5.2.2",
    "vite": "^8.1.1"
  }
}
